<snet:WindowBase
    x:Class="Snet.Windows.PerformanceTesting.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Snet.Windows.PerformanceTesting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:snet="https://snet.cn"
    xmlns:ui="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="{snet:Loc SystemTitle}"
    Width="1000"
    Height="800"
    snet:ResxLocalizationProvider.DefaultAssembly="Snet.Windows.PerformanceTesting"
    snet:ResxLocalizationProvider.DefaultDictionary="Language"
    Icon="/icon.ico"
    LoadAnimationEnabled="true"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <snet:WindowBase.Resources>
        <ResourceDictionary>
            <snet:RadioButtonConverter x:Key="RadioButtonConverter" />
        </ResourceDictionary>
    </snet:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="90" />
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            Margin="5,5,5,0"
            Padding="0"
            ui:ElevationAssist.Elevation="Dp2"
            ui:GroupBoxAssist.HeaderPadding="7"
            Header="{Binding}"
            Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ui:PackIcon Grid.Column="0" Kind="Settings" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{snet:Loc 服务地址设置}"
                            TextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                </Grid.ColumnDefinitions>
                <snet:TextBoxControl
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Hint="{snet:Loc 地址}"
                    Icon="{DynamicResource Address}"
                    Text="{Binding Address}" />
                <snet:TextBoxControl
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Hint="{snet:Loc 主题}"
                    Icon="{DynamicResource Topic}"
                    Text="{Binding Topic}" />
                <snet:TextBoxControl
                    Grid.Column="2"
                    Margin="0,0,0,0"
                    Hint="{snet:Loc 前缀}"
                    Icon="{DynamicResource AV}"
                    Text="{Binding Prefix}" />
                <Grid Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <snet:ButtonControl
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        Command="{Binding Start}"
                        Content="{snet:Loc 启动}"
                        Icon="{DynamicResource Start}" />
                    <snet:ButtonControl
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding Stop}"
                        Content="{snet:Loc 停止}"
                        Icon="{DynamicResource Stop}" />

                </Grid>
            </Grid>
        </GroupBox>

        <!--  数据类型  -->
        <GroupBox
            Grid.Row="1"
            Margin="5"
            Padding="0"
            ui:ElevationAssist.Elevation="Dp2"
            ui:GroupBoxAssist.HeaderPadding="7"
            Header="{Binding}"
            Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ui:PackIcon Grid.Column="0" Kind="CallMerge" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{snet:Loc 数据类型}"
                            TextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <Grid Margin="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="String"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=20}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Double"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=2}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Float"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=3}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Bool"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=1}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Int"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=9}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="UInt"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=11}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Long"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=13}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="ULong"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=15}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Short"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=5}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="UShort"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=7}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />

                <RadioButton
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Byte[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=22}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Double[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=24}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Float[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=25}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Bool[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=23}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Int[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=31}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="5"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="UInt[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=33}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="6"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Long[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=35}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="7"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="ULong[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=37}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="8"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Short[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=27}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
                <RadioButton
                    Grid.Row="1"
                    Grid.Column="9"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="UShort[]"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsChecked="{Binding DataType, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=29}"
                    Style="{StaticResource MaterialDesignSecondaryRadioButton}" />
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Margin="5,5,5,0"
            Padding="0"
            ui:ElevationAssist.Elevation="Dp2"
            ui:GroupBoxAssist.HeaderPadding="7"
            Header="{Binding}"
            Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ui:PackIcon Grid.Column="0" Kind="Settings" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{snet:Loc 点位数据设置}"
                            TextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                </Grid.ColumnDefinitions>
                <snet:TextBoxControl
                    Grid.Column="0"
                    Margin="0,0,0,0"
                    Hint="{snet:Loc 数量}"
                    Icon="{DynamicResource Count}"
                    Text="{Binding Count}" />

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <snet:ButtonControl
                        Margin="10,0,0,0"
                        Command="{Binding Send}"
                        Content="{snet:Loc 发送}"
                        Icon="{DynamicResource Send}" />
                    <snet:ButtonControl
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding StopSend}"
                        Content="{snet:Loc 停止发送}"
                        Icon="{DynamicResource Stop}" />

                </Grid>
            </Grid>
        </GroupBox>
        <GroupBox
            Grid.Row="3"
            Margin="5,5,5,0"
            Padding="0"
            ui:ElevationAssist.Elevation="Dp2"
            ui:GroupBoxAssist.HeaderPadding="7"
            Header="{Binding}"
            Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ui:PackIcon Grid.Column="0" Kind="Settings" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{snet:Loc 循环次数设置}"
                            TextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                </Grid.ColumnDefinitions>
                <snet:TextBoxControl
                    Grid.Column="0"
                    Margin="0,0,0,0"
                    Hint="{snet:Loc 次数}"
                    Icon="{DynamicResource Count}"
                    Text="{Binding Frequency}" />


                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <snet:ButtonControl
                        Margin="10,0,0,0"
                        Command="{Binding LoopSend}"
                        Content="{snet:Loc 循环发送}"
                        Icon="{DynamicResource Send}" />
                    <snet:ButtonControl
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding StopLoopSend}"
                        Content="{snet:Loc 停止循环发送}"
                        Icon="{DynamicResource Stop}" />

                </Grid>

            </Grid>
        </GroupBox>

        <!--  信息事件  -->
        <GroupBox
            Grid.Row="4"
            Margin="5"
            Padding="0"
            ui:ElevationAssist.Elevation="Dp2"
            ui:GroupBoxAssist.HeaderPadding="7"
            Header="{Binding}"
            Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ui:PackIcon Grid.Column="0" Kind="InformationVariant" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{snet:Loc 日志信息}"
                            TextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <Grid>
                <!--  清空按钮  -->
                <Button
                    Width="80"
                    Height="30"
                    Margin="0,-31,0,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ui:ButtonAssist.CornerRadius="0,5,0,0"
                    Command="{Binding Clear}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{DynamicResource Clear}"
                                Stretch="Fill" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{snet:Loc 清空}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
                <!--  数据框  -->
                <TextBox
                    Margin="5"
                    AcceptsReturn="True"
                    BorderThickness="0,0,0,0"
                    Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                    IsReadOnly="True"
                    Style="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                    Text="{Binding Info}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <snet:EventCommand Command="{Binding InfoTextChanged}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
        </GroupBox>
    </Grid>
</snet:WindowBase>
